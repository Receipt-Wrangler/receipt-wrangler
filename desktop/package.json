{
  "name": "receipt-wrangler",
  "version": "1.3.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config ./proxy.conf.json --host 0.0.0.0",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "test:watch": "ng test --watch",
    "test:coverage": "ng test --watch=false --coverage",
    "test:ci": "ng test --watch=false --coverage --no-progress",
    "e2e": "playwright test",
    "e2e:ci": "playwright test --fail-on-flaky-tests",
    "e2e:ui": "playwright test --ui",
    "e2e:install": "playwright install --with-deps chromium"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "21.2.14",
    "@angular/common": "21.2.25",
    "@angular/compiler": "21.2.25",
    "@angular/core": "21.2.25",
    "@angular/forms": "21.2.25",
    "@angular/material": "21.2.14",
    "@angular/platform-browser": "21.2.25",
    "@angular/router": "21.2.25",
    "@fontsource/inter": "^5.0.17",
    "@fontsource/raleway": "^5.0.17",
    "@ngxs/storage-plugin": "^21.0.0",
    "@ngxs/store": "^21.0.0",
    "@types/qrcode": "^1.5.6",
    "bootstrap": "^5.3.3",
    "chart.js": "^4.4.8",
    "date-fns": "^4.1.0",
    "material-icons": "^1.13.1",
    "ng2-charts": "^9.0.0",
    "ngx-mask": "21.0.1",
    "pretty-print-json": "^3.0.1",
    "qrcode": "^1.5.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "~21.2.27",
    "@angular/cli": "~21.2.27",
    "@angular/compiler-cli": "21.2.25",
    "@ngxs/devtools-plugin": "^21.0.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^20.12.3",
    "@vitest/coverage-v8": "4.1.12",
    "jsdom": "^29.1.1",
    "typescript": "~5.9.3",
    "vitest": "4.1.12"
  },
  "overrides": {
    "@babel/core": "^7.29.7",
    "esbuild": "^0.28.1",
    "ts-morph": "^28.0.0",
    "undici": "^7.29.1"
  }
}
