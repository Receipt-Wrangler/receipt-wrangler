# Copy to .env on the server and fill in with: openssl rand -hex 32
# Back these up somewhere safe. Losing ENCRYPTION_KEY makes stored secrets
# (system email passwords, AI provider keys) unreadable; changing SECRET_KEY
# signs everyone out.
SECRET_KEY=
ENCRYPTION_KEY=

# Public hostname Caddy serves and gets a certificate for. sslip.io resolves to the IP
# in its name; swap in a real domain pointed at the VM whenever you have one.
SITE_ADDRESS=129-151-18-218.sslip.io
